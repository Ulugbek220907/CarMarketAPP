<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Screen Navigation Header / Seller Profile Header -->
    <LinearLayout
        android:id="@+id/chatHeader"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/surface_container_lowest"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="6dp"
            android:src="@drawable/ic_back"
            app:tint="@color/on_surface" />

        <!-- Seller Avatar with Online Badge -->
        <FrameLayout
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_chip_spec"
                android:padding="8dp"
                android:src="@drawable/ic_nav_profile"
                app:tint="@color/primary_container" />

            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/bg_badge_emerald" />
        </FrameLayout>

        <!-- Seller Name & Status -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvSellerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/on_surface"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="Marcus Chen" />

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/ic_verified"
                    app:tint="@color/deal_emerald" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvSellerStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Response time ~10 min"
                android:textColor="@color/on_surface_variant"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Call Action Button -->
        <ImageView
            android:id="@+id/btnCallSeller"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_phone"
            app:tint="@color/primary_container" />
    </LinearLayout>

    <View
        android:id="@+id/dividerHeader"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/outline_variant"
        app:layout_constraintTop_toBottomOf="@id/chatHeader" />

    <!-- Contextual Pinned Listing Card -->
    <LinearLayout
        android:id="@+id/pinnedListingCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_container_low"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        app:layout_constraintTop_toBottomOf="@id/dividerHeader">

        <!-- Thumbnail -->
        <ImageView
            android:id="@+id/ivListingThumb"
            android:layout_width="56dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_chip_spec"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_car_silhouette" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvPinnedTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/on_surface"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="2022 Tesla Model 3 Long Range" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvPinnedPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/on_surface"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="$31,450" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_badge_emerald_light"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="Listed • Active"
                    android:textColor="@color/primary_container"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- View Details Button -->
        <Button
            android:id="@+id/btnViewDetails"
            style="@style/AutoMarket.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:paddingHorizontal="10dp"
            android:text="Details"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:id="@+id/dividerPinned"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/outline_variant"
        app:layout_constraintTop_toBottomOf="@id/pinnedListingCard" />

    <!-- Message Stream (Scrollable) -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:padding="16dp"
        app:layout_constraintBottom_toTopOf="@id/quickChipsBar"
        app:layout_constraintTop_toBottomOf="@id/dividerPinned">

        <LinearLayout
            android:id="@+id/containerMessages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Date Pill -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_chip_spec"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:text="Today, 10:14 AM"
                android:textColor="@color/on_surface_variant"
                android:textSize="11sp" />

            <!-- Purchase Protection Banner -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/surface_container_lowest"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/outline_variant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="10dp">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="@drawable/bg_chip_spec"
                        android:padding="6dp"
                        android:src="@drawable/ic_shield"
                        app:tint="@color/primary_container" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="@string/chat_protection"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Dynamic Messages will be populated here programmatically -->
            <LinearLayout
                android:id="@+id/llDynamicMessages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Contextual Quick Action Suggestion Chips Bar -->
    <HorizontalScrollView
        android:id="@+id/quickChipsBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_container_lowest"
        android:overScrollMode="never"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/dockBar">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipSuggest1"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip_category_inactive"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="@string/chip_negotiable"
                android:textColor="@color/on_surface"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/chipSuggest2"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip_category_inactive"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="@string/chip_test_drive"
                android:textColor="@color/on_surface"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/chipSuggest3"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip_category_inactive"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="@string/chip_carfax"
                android:textColor="@color/on_surface"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/chipSuggest4"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_chip_category_inactive"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="@string/chip_counter"
                android:textColor="@color/primary_container"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Message Input Dock Bar -->
    <LinearLayout
        android:id="@+id/dockBar"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:background="@color/surface_container_lowest"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Attachment Button -->
        <FrameLayout
            android:id="@+id/btnAttach"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_card_rounded"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_add"
                app:tint="@color/on_surface" />
        </FrameLayout>

        <!-- Input Text Field -->
        <EditText
            android:id="@+id/etMessage"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginHorizontal="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_rounded"
            android:hint="@string/chat_input_hint"
            android:imeOptions="actionSend"
            android:inputType="textCapSentences"
            android:maxLines="3"
            android:paddingHorizontal="14dp"
            android:textColor="@color/on_surface"
            android:textColorHint="@color/outline"
            android:textSize="14sp" />

        <!-- Send Button -->
        <FrameLayout
            android:id="@+id/btnSend"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/btn_primary_blue"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_send"
                app:tint="@color/white" />
        </FrameLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
